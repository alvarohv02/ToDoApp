# --- WhatsApp Cloud API (Meta) ---
# Token de acceso de Meta (idealmente uno permanente de usuario del sistema)
TOKEN=EAA...
# Identificador del número de WhatsApp Business (no es el número de teléfono)
WHATSAPP_PHONE_NUMBER_ID=123456789012345
# Palabra que pones en "Verify token" al configurar el webhook en Meta
WHATSAPP_VERIFY_TOKEN=elige-una-palabra-secreta
# Números que pueden hablar con el bot, formato internacional sin + ni espacios, separados por comas
WHATSAPP_ALLOWED_NUMBERS=34600000000
# Recomendado: "App secret" de tu app de Meta, para verificar que los webhooks vienen de Meta
WHATSAPP_APP_SECRET=
# Opcional: plantilla aprobada para recordatorios fuera de la ventana de 24 h (ver deploy/INSTALAR.md)
# WHATSAPP_REMINDER_TEMPLATE=recordatorio
# WHATSAPP_REMINDER_TEMPLATE_LANG=es
# Opcional: versión de la Graph API
# WHATSAPP_API_VERSION=v23.0

# --- Telegram ---
# Token que te da @BotFather al crear el bot (/newbot). Si está vacío, Telegram no se arranca
TELEGRAM_TOKEN=
# Quién puede usar el bot: ids numéricos o @usuarios, separados por comas.
# Si no sabes tu id, escribe al bot y te lo dirá.
TELEGRAM_ALLOWED_USERS=@tu_usuario

# --- Tareas ---
# A quién se asignan las tareas nuevas si no se dice nadie (si se deja vacío: "Sin asignar")
PERSONA_POR_DEFECTO=Yo

# --- Cuentas vinculadas ---
# Chats que son de la misma persona: así ve sus recordatorios pregunte por WhatsApp o por Telegram.
# Grupos separados por ';' y chats por ','. Telegram con el prefijo tg: (tu id de Telegram).
# CUENTAS_VINCULADAS=34600111222,tg:123456789

# --- Google Calendar (opcional) ---
# Sincroniza eventos y tareas con fecha con un calendario "Mi Notion" de tu cuenta de Google.
# Se obtienen con deploy/autorizar_google.py (ver deploy/INSTALAR.md). Sin ellas no se sincroniza.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# GOOGLE_SYNC_SEGUNDOS=120

# --- Copias de seguridad ---
# Cada día, a partir de esta hora, se guarda una copia de la base de datos en data/copias/
# COPIA_HORA=4
# Cuántas copias diarias se conservan
# COPIA_DIAS=14
# true = enviarte también la copia por Telegram (al primer id numérico de TELEGRAM_ALLOWED_USERS),
# para tenerla fuera del servidor si falla el disco
# COPIA_TELEGRAM=false

# --- LLM local (Ollama, en tu servidor) ---
# Solo si el servidor puede mover un LLM (>= 8 GB RAM y CPU con AVX2 o GPU)
OLLAMA_ENABLED=false
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# Segundos máximos de espera (con CPU sin GPU puede tardar bastante)
OLLAMA_TIMEOUT=180
